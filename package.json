{
  "name": "dshremote-bridge",
  "version": "0.2.5",
  "type": "module",
  "description": "DSH Remote 桥插件：监听 DSH 的回合结束事件并推送给手机，把 DSH Web 反代到局域网端口，并在 Web UI 左下角提供配对二维码。",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "vendor",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": {
    "node": ">=24.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Charlie-yangjiaqi/dsh-mobile-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Charlie-yangjiaqi/dsh-mobile-bridge/issues"
  },
  "homepage": "https://github.com/Charlie-yangjiaqi/dsh-mobile-bridge#readme",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "remote",
    "mobile",
    "cloudflare-tunnel"
  ],
  "license": "MIT",
  "dependencies": {
    "dijkstrajs": "^1.0.3"
  },
  "devDependencies": {
    "ws": "^8.23.0"
  }
}
